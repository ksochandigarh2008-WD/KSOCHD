# ---------------------------------------------------------------------------
# Copy this file to `.env.local` (never commit that one) and fill in what you need.
# Every variable is OPTIONAL — the site works with none of them set.
# ---------------------------------------------------------------------------

# 1. BACKEND (optional)
# Point this at your own API and the app uses real HTTP calls instead of the
# browser-only store. When a request fails it silently falls back to localStorage,
# so the site never breaks.
# Expected endpoints: GET/PUT /content, /ledger, /members, /submissions, POST /ai/chat
VITE_API_BASE_URL=

# 1b. SUPABASE (optional) — membership + finance move from localStorage to Postgres
# See DEPLOY.md §1b for the table schema and RLS policies.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 2. BASE PATH (only for GitHub Pages project sites)
# Leave "/" for Vercel, Netlify, CloudFront or a root domain.
# Example: BASE_PATH=/kso-website npm run build
BASE_PATH=/

# 3. GOOGLE ANALYTICS / PLAUSIBLE (optional)
VITE_ANALYTICS_ID=

# 4. PAYMENT GATEWAY (optional, for real donations)
# The donate page currently records intent locally. Add Razorpay/Stripe keys here
# and wire them into src/pages/Donate.jsx step 4 — see DEPLOY.md.
VITE_RAZORPAY_KEY_ID=
