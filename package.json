{
  "name": "kso-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "KSO Chandigarh \u2014 NGO website (React + Vite + Tailwind) with AI assistant and built-in control panel",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "deploy:pages": "npm run build && gh-pages -d dist",
    "test": "npm run test:scan && npm run test:ssr && npm run test:dom",
    "test:ssr": "SMOKE_ENTRY=entry.ssr.jsx SMOKE_OUT=.build vite build --config tests/vite.config.js && node tests/run-ssr.mjs",
    "test:dom": "SMOKE_ENTRY=entry.dom.jsx SMOKE_OUT=.build vite build --config tests/vite.config.js && node tests/run-dom.mjs",
    "sitemap": "node scripts/make-sitemap.mjs",
    "test:scan": "node tests/scan-identifiers.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/supabase-js": "^2.109.0",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.454.0",
    "marked": "^12.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.88.0",
    "react-router-dom": "^6.27.0",
    "recharts": "^2.15.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.1",
    "uuid": "^11.1.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "jsdom": "^24.1.3",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^5.4.10"
  }
}
