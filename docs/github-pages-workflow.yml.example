# GitHub Pages deployment — DISABLED (kept as a reference).
#
# This file was moved out of .github/workflows/ because committing a workflow needs a
# GitHub token with the `workflow` scope. To enable automatic GitHub Pages deploys:
#   1. regenerate your token with the `workflow` scope
#   2. move this file back:  git mv docs/github-pages-workflow.yml.example .github/workflows/deploy-pages.yml
#
# Not needed on Netlify, Vercel or Cloudflare Pages — those hosts build the site
# themselves and this file would only trigger a second, unnecessary deploy.
name: Deploy to GitHub Pages

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm
      - run: npm ci
      - run: npm run build
        env:
          # For a project site (https://user.github.io/kso-website) set BASE_PATH=/kso-website
          # For a user/org site (https://user.github.io) leave it as "/"
          BASE_PATH: ${{ vars.BASE_PATH || '/' }}
          VITE_API_BASE_URL: ${{ vars.VITE_API_BASE_URL || '' }}
      # GitHub Pages has no rewrite rules — serve index.html for unknown paths
      - run: cp dist/index.html dist/404.html
      - uses: actions/upload-pages-artifact@v3
        with:
          path: dist

  deploy:
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - id: deployment
        uses: actions/deploy-pages@v4
